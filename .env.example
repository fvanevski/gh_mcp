# Required. A personal access token (classic or fine-grained) with sufficient scopes.
# gh commands read this from the environment or from `gh auth status`.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Safer default: read-only tools work, write tools are disabled.
MCP_GH_ALLOW_WRITE_COMMANDS=false

# Optional write scope. If either list is populated, only matching targets pass.
MCP_GH_ALLOWED_REPOSITORIES=
MCP_GH_ALLOWED_OWNERS=

# Higher-impact operations require a separate opt-in.
MCP_GH_ALLOW_REPO_CREATION=false
MCP_GH_ALLOW_RELEASE_CREATION=false
MCP_GH_ALLOW_WORKFLOW_DISPATCH=false
MCP_GH_ALLOW_CONTENT_COMMITS=false

# Bounds for one atomic repository-content commit.
MCP_GH_MAX_COMMIT_FILES=100
MCP_GH_MAX_FILE_BYTES=1000000
MCP_GH_MAX_COMMIT_BYTES=5000000

# Maximum number of results to return per search query.
MCP_GH_DEFAULT_MAX_RESULTS=30
MCP_GH_HARD_MAX_RESULTS=100
MCP_GH_COMMAND_TIMEOUT_SECONDS=30

# Transport used by the `mcp-gh` console command.
# stdio is recommended for a local IDE/agent host.
MCP_GH_TRANSPORT=stdio
MCP_GH_HTTP_HOST=127.0.0.1
MCP_GH_HTTP_PORT=8766

MCP_GH_LOG_LEVEL=INFO
