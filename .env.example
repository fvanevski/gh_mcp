# Required. A personal access token (classic or fine-grained) with sufficient scopes.
# gh commands read this from the environment or from `gh auth status`.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Safer default: read-only tools work, write tools are disabled.
MCP_GH_ALLOW_WRITE_COMMANDS=false

# Optional ordinary write scope. If either list is populated, only matching targets pass.
MCP_GH_ALLOWED_REPOSITORIES=
MCP_GH_ALLOWED_OWNERS=

# Exact high-risk target policy. These lists are additional prerequisites when the
# corresponding fine gate is enabled; empty lists fail closed.
# Repository creation: comma-separated canonical prospective OWNER/REPO targets.
# Example: MCP_GH_ALLOWED_REPO_CREATION_TARGETS=octo/new-repo
MCP_GH_ALLOWED_REPO_CREATION_TARGETS=
# Workflow dispatch: comma-separated OWNER/REPO@WORKFLOW targets, where WORKFLOW is
# either a positive numeric workflow ID or an exact case-sensitive
# .github/workflows/<file>.yml|yaml path.
# Example: MCP_GH_ALLOWED_WORKFLOW_DISPATCH_TARGETS=octo/repo@12345,octo/repo@.github/workflows/Release.yml
MCP_GH_ALLOWED_WORKFLOW_DISPATCH_TARGETS=

# Higher-impact operations require a separate opt-in.
MCP_GH_ALLOW_REPO_CREATION=false
MCP_GH_ALLOW_RELEASE_CREATION=false
MCP_GH_ALLOW_WORKFLOW_DISPATCH=false
MCP_GH_ALLOW_CONTENT_COMMITS=false
MCP_GH_ALLOW_PR_MERGE=false

# Bounds for one atomic repository-content commit.
MCP_GH_MAX_COMMIT_FILES=100
MCP_GH_MAX_FILE_BYTES=1000000
MCP_GH_MAX_COMMIT_BYTES=5000000

# Bounds for bounded review and Actions evidence reads.
MCP_GH_MAX_PR_DIFF_BYTES=500000
MCP_GH_MAX_PR_FILE_PATCH_BYTES=8000
MCP_GH_MAX_PR_COMMIT_MESSAGE_BYTES=4000
MCP_GH_MAX_FAILED_RUN_LOG_BYTES=500000
# Maximum Actions log evidence retained in memory/returned by one general log read.
MCP_GH_MAX_ACTION_LOG_BYTES=500000
# Maximum jobs that gh_get_run_logs may enumerate/aggregate for one exact attempt.
# Must be a multiple of GitHub's 100-job page size; allowed range: 100-1000.
MCP_GH_MAX_ACTION_LOG_JOBS=100

# Maximum number of results to return per search query.
MCP_GH_DEFAULT_MAX_RESULTS=30
MCP_GH_HARD_MAX_RESULTS=100
MCP_GH_COMMAND_TIMEOUT_SECONDS=30

# Local safety floor for gh_get_api_rate_status refreshes.
# Repeated calls inside this interval reuse the most recent governed /rate_limit observation.
# This is local polling policy, not a GitHub secondary-rate-limit threshold. Minimum: 1 second.
MCP_GH_API_RATE_STATUS_MIN_INTERVAL_SECONDS=5

# Transport used by the `mcp-gh` console command.
# stdio is recommended for a local IDE/agent host.
MCP_GH_TRANSPORT=stdio
MCP_GH_HTTP_HOST=127.0.0.1
MCP_GH_HTTP_PORT=8766

MCP_GH_LOG_LEVEL=INFO
